# ARIA Environment Configuration
# Copy to .env and fill in your values

# Anthropic (required for Personalizer Agent)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Pinecone (required for RAG vector store)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=aria-products

# Database
DATABASE_URL=postgresql://aria:aria@localhost:5432/aria

# Redis (state caching)
REDIS_URL=redis://localhost:6379

# WhatsApp Business API (Meta)
WHATSAPP_API_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# App settings
DEBUG=true
LOG_LEVEL=INFO
MAX_BATCH_SIZE=1000
